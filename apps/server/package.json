{
  "name": "@ping/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./app-type": "./src/app-type.ts"
  },
  "scripts": {
    "dev": "PORT=${SERVER_PORT:-3000} tsx watch --clear-screen=false src/index.ts",
    "start": "NODE_ENV=production tsx src/index.ts",
    "db:migrate": "tsx src/db/cli/migrate.ts",
    "db:seed": "tsx src/db/cli/seed.ts",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@hono/node-server": "2.1.11",
    "@hono/zod-validator": "0.9.1",
    "@ping/shared": "workspace:*",
    "@sentry/node": "11.16.0",
    "better-auth": "1.7.27",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.19",
    "nodemailer": "10.6.1",
    "pg": "8.23.1",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11"
  }
}
