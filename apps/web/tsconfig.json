{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "../../node_modules/.tsbuild/web",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    // For TypeScript only: Vite, Vitest and dependency-cruiser read package.json#imports.
    "paths": { "#/*": ["./src/*"] }
  },
  "include": ["src"],
  "references": [{ "path": "../server" }]
}
